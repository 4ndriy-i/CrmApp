<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CrmApp.ViewModels"
             x:Class="CrmApp.Views.ClientDetailPage"
             x:DataType="vm:ClientDetailViewModel"
             Title="Деталі клієнта">

    <VerticalStackLayout Padding="16" Spacing="10">
        <Label Text="Ім'я клієнта" />
        <Entry Text="{Binding Name}" />
        <Label Text="Компанія" />
        <Entry Text="{Binding Company}" />
        <Label Text="Телефон" />
        <Entry Keyboard="Telephone" Text="{Binding Phone}" />
        <Label Text="Сума угоди, ₴" />
        <Entry Keyboard="Numeric" Text="{Binding DealAmountText}" />

        <Button Text="Зберегти зміни" Command="{Binding SaveCommand}" />
        <Button Text="Скасувати" Command="{Binding CancelCommand}" />
        <Button Text="Видалити клієнта" Command="{Binding DeleteCommand}" BackgroundColor="Firebrick" />
        <Label Text="{Binding StatusMessage}" TextColor="Gray" />
    </VerticalStackLayout>
</ContentPage>